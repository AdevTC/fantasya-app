{
  "name": "fantasya-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/run-with-firebase-emulators.mjs --ui \"npm run dev:session\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:emulators": "firebase emulators:start --project demo-fantasya --only auth,firestore,functions,storage",
    "dev:seed": "npm --prefix functions run seed:emulators",
    "dev:session": "run-s dev:seed dev:web",
    "build": "vite build",
    "lint": "eslint .",
    "test:unit": "node --test tests/unit/*.test.js functions/test/emulator-guard.test.js",
    "test:seed": "node scripts/run-with-firebase-emulators.mjs \"npm --prefix functions run test:seed\"",
    "test:rules:admin": "node scripts/run-with-firebase-emulators.mjs \"node --test --test-concurrency=1 tests/rules/users-admin.test.js\"",
    "test:rules:leagues": "node scripts/run-with-firebase-emulators.mjs \"node --test --test-concurrency=1 tests/rules/leagues.test.js\"",
    "test:admin": "node scripts/run-with-firebase-emulators.mjs \"npm --prefix functions run test:admin\"",
    "test:rules:integrity": "node --test --test-concurrency=1 tests/rules/leagues.test.js tests/rules/social-chat.test.js tests/rules/storage.test.js",
    "test:functions:integrity": "npm --prefix functions run test:integrity",
    "test:integrity:inside": "run-s test:rules:integrity test:functions:integrity",
    "test:integrity": "npm run test:ci",
    "test:rules:inside": "node --test --test-concurrency=1 tests/rules/users-admin.test.js tests/rules/leagues.test.js tests/rules/social-chat.test.js tests/rules/storage.test.js",
    "test:functions:inside": "npm --prefix functions run test:all",
    "test:inside-emulators": "run-s check:node dev:seed test:unit test:rules:inside test:functions:inside",
    "test:ci": "node scripts/run-with-firebase-emulators.mjs \"npm run test:inside-emulators\"",
    "check:node": "node scripts/check-node-version.mjs",
    "check:functions": "npm --prefix functions run check",
    "preview": "vite preview",
    "firebase:login": "firebase login",
    "firebase:deploy:rules": "firebase deploy --project tictaktools --only firestore:rules",
    "firebase:deploy:firestore": "firebase deploy --project tictaktools --only firestore",
    "firebase:deploy:functions": "firebase deploy --project tictaktools --only functions",
    "firebase:deploy:all": "firebase deploy --project tictaktools"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.1.0",
    "firebase": "^11.10.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.6.3",
    "recharts": "^3.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-tools": "^15.28.2",
    "globals": "^16.3.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.3"
  }
}
