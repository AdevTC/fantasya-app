rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================================
    // HELPER FUNCTIONS
    // ============================================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of a document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'superadmin';
    }

    function togglesOnlyOwnUid(before, after) {
      return isAuthenticated()
        && before is list
        && after is list
        && after.size() == after.toSet().size()
        && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
        && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }

    function isChatParticipant(chatId) {
      let chatPath = /databases/$(database)/documents/chats/$(chatId);
      return isAuthenticated()
        && exists(chatPath)
        && get(chatPath).data.participants is list
        && request.auth.uid in get(chatPath).data.participants;
    }

    function isOwnUsername(username) {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated()
        && exists(profilePath)
        && username == get(profilePath).data.username;
    }

    function isOptionalUrl(value) {
      return value == null
        || (value is string && value.size() <= 2048);
    }

    function isValidSocialAuthor(data) {
      return data.authorUsername is string
        && data.authorUsername.size() >= 3
        && data.authorUsername.size() <= 16
        && isOwnUsername(data.authorUsername)
        && isOptionalUrl(data.authorPhotoURL);
    }

    function isValidTag(tag) {
      return tag is string && tag.matches('[a-z0-9]{1,32}');
    }

    function areValidTags(tags) {
      return tags is list
        && tags.size() <= 5
        && tags.size() == tags.toSet().size()
        && (tags.size() < 1 || isValidTag(tags[0]))
        && (tags.size() < 2 || isValidTag(tags[1]))
        && (tags.size() < 3 || isValidTag(tags[2]))
        && (tags.size() < 4 || isValidTag(tags[3]))
        && (tags.size() < 5 || isValidTag(tags[4]));
    }

    function isValidPostData(data) {
      return isValidSocialAuthor(data)
        && data.content is string
        && data.content.size() <= 280
        && isOptionalUrl(data.imageURL)
        && (data.content.size() > 0
          || (data.imageURL is string && data.imageURL.size() > 0))
        && areValidTags(data.tags)
        && data.likes is list
        && data.createdAt is timestamp;
    }

    function isValidCommentData(data) {
      return isValidSocialAuthor(data)
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 1000
        && data.likes is list
        && data.createdAt is timestamp;
    }

    function isValidReplyData(data) {
      return isValidSocialAuthor(data)
        && data.content is string
        && data.content.size() > 0
        && data.content.size() <= 1000
        && data.createdAt is timestamp;
    }

    function leagueAfter(leagueId) {
      return getAfter(
        /databases/$(database)/documents/leagues/$(leagueId)
      ).data;
    }

    function seasonData(leagueId, seasonId) {
      return get(
        /databases/$(database)/documents/leagues/$(leagueId)/seasons/$(seasonId)
      ).data;
    }

    function isLeagueOwner(leagueId) {
      return isAuthenticated()
        && get(
          /databases/$(database)/documents/leagues/$(leagueId)
        ).data.ownerId == request.auth.uid;
    }

    function isLeagueOwnerAfter(leagueId) {
      return isAuthenticated()
        && leagueAfter(leagueId).ownerId == request.auth.uid;
    }

    function isLeagueMember(leagueId, seasonId) {
      return isAuthenticated()
        && request.auth.uid in seasonData(leagueId, seasonId).members;
    }

    function isLeagueAdmin(leagueId, seasonId) {
      return isLeagueMember(leagueId, seasonId)
        && seasonData(leagueId, seasonId).members[request.auth.uid].role == 'admin';
    }

    function changesOnlyOwnMember() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members)
          .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid]
          .diff(resource.data.members[request.auth.uid]).affectedKeys()
          .hasOnly(['teamName', 'photoURL', 'finances']);
    }

    function removesOnlyOwnMembership(leagueId) {
      return request.auth.uid != get(
          /databases/$(database)/documents/leagues/$(leagueId)
        ).data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members)
          .affectedKeys().hasOnly([request.auth.uid])
        && request.auth.uid in resource.data.members
        && !(request.auth.uid in request.resource.data.members);
    }

    function preservesLeagueOwner(leagueId) {
      let ownerId = get(
        /databases/$(database)/documents/leagues/$(leagueId)
      ).data.ownerId;
      return ownerId in request.resource.data.members
        && request.resource.data.members[ownerId].role == 'admin';
    }

    // ============================================================================
    // USERS COLLECTION
    // ============================================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if (
          isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['bio', 'photoURL', 'pinnedTrophies', 'savedPosts', 'following'])
        ) || (
          isAuthenticated()
          && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['followers'])
          && resource.data.followers is list
          && request.resource.data.followers is list
          && togglesOnlyOwnUid(
            resource.data.followers,
            request.resource.data.followers
          )
        );
      allow delete: if false;

      // Achievement subcollection
      match /achievements/{seasonId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      // Feats subcollection (user accomplishments)
      match /feats/{featId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // ============================================================================
    // CAREER ACHIEVEMENTS COLLECTION (cross-season achievements tracking)
    // ============================================================================

    match /career_achievements/{userId} {
      // Users can read their own career achievements
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // ============================================================================
    // USERNAMES COLLECTION (for uniqueness)
    // ============================================================================

    match /usernames/{username} {
      // Anyone can read to check availability
      allow read: if true;
      // The profile and its uniqueness index are changed together by Functions.
      allow create, update, delete: if false;
    }

    // ============================================================================
    // LEAGUES COLLECTION
    // ============================================================================

    match /leagues/{leagueId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys()
          .hasAll(['name', 'ownerId', 'activeSeason']);
      allow update: if request.resource.data.ownerId == resource.data.ownerId
        && (isLeagueOwner(leagueId)
          || (resource.data.activeSeason != null
            && isLeagueAdmin(leagueId, resource.data.activeSeason)));
      allow delete: if isLeagueOwner(leagueId);

      match /seasons/{seasonId} {
        allow read: if isAuthenticated();
        allow create: if isLeagueOwnerAfter(leagueId)
          && request.resource.data.keys()
            .hasAll(['name', 'seasonNumber', 'inviteCode', 'members'])
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members[request.auth.uid].role == 'admin';
        allow update: if (isLeagueOwner(leagueId)
            || isLeagueAdmin(leagueId, seasonId))
          && preservesLeagueOwner(leagueId);
        allow update: if isLeagueMember(leagueId, seasonId)
          && changesOnlyOwnMember();
        allow update: if isLeagueMember(leagueId, seasonId)
          && removesOnlyOwnMembership(leagueId);
        allow delete: if isLeagueOwner(leagueId);

        match /members/{userId} {
          allow read: if isLeagueMember(leagueId, seasonId);
          allow write: if false;
        }

        match /rounds/{roundId} {
          allow read: if isAuthenticated();
          allow write: if isLeagueAdmin(leagueId, seasonId);
        }

        match /lineups/{lineupId} {
          allow read: if isAuthenticated();
          allow create, update: if isLeagueAdmin(leagueId, seasonId)
            || (isLeagueMember(leagueId, seasonId)
              && lineupId.matches('.*-' + request.auth.uid + '$'));
          allow delete: if isLeagueAdmin(leagueId, seasonId);
        }

        match /transfers/{transferId} {
          allow read: if isLeagueMember(leagueId, seasonId);
          allow create: if false;
          allow update, delete: if isLeagueAdmin(leagueId, seasonId);
        }

        match /achievements/{userId} {
          allow read: if isAuthenticated();
          allow write: if false;
        }

        match /challenges/{challengeId} {
          allow read: if isAuthenticated();
          allow write: if false;
        }

        match /joinRequests/{requestId} {
          allow create, update, delete: if false;
          allow read: if isLeagueAdmin(leagueId, seasonId)
            || (isAuthenticated()
              && resource.data.userId == request.auth.uid);
        }

        match /porra/{porraId} {
          allow read: if isAuthenticated();
          allow write: if isLeagueAdmin(leagueId, seasonId);

          match /predictions/{predictionId} {
            allow read: if isAuthenticated();
            allow create, update: if isLeagueAdmin(leagueId, seasonId)
              || (isLeagueMember(leagueId, seasonId)
                && predictionId == request.auth.uid);
            allow delete: if isLeagueAdmin(leagueId, seasonId);
          }
        }
      }
    }

    // ============================================================================
    // CHATS COLLECTION (private messages)
    // ============================================================================

    match /chats/{chatId} {
      allow read: if isAuthenticated()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      allow create, delete: if false;
      allow update: if isChatParticipant(chatId)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastMessageTimestamp'
        ]);

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys()
            .hasAll(['senderId', 'senderUsername', 'createdAt'])
          && request.resource.data.keys().hasOnly([
            'senderId',
            'senderUsername',
            'text',
            'createdAt',
            'read',
            'imageUrl'
          ])
          && request.resource.data.senderUsername is string
          && request.resource.data.senderUsername.size() <= 128
          && isOwnUsername(request.resource.data.senderUsername)
          && (!('read' in request.resource.data)
            || request.resource.data.read == false)
          && (!('text' in request.resource.data)
            || (request.resource.data.text is string
              && request.resource.data.text.size() <= 500))
          && (!('imageUrl' in request.resource.data)
            || (request.resource.data.imageUrl is string
              && request.resource.data.imageUrl.size() <= 2048))
          && (('text' in request.resource.data
              && request.resource.data.text.size() > 0)
            || ('imageUrl' in request.resource.data
              && request.resource.data.imageUrl.size() > 0));
        allow update, delete: if false;
      }
    }

    // ============================================================================
    // FEED POSTS (social feature)
    // ============================================================================

    match /posts/{postId} {
      allow read: if true;
      allow create: if false;
      allow update: if isAuthenticated()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['content', 'tags'])
        && isValidPostData(request.resource.data);
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes'])
        && togglesOnlyOwnUid(
          resource.data.likes,
          request.resource.data.likes
        );
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isSuperAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys()
            .hasAll([
              'authorId',
              'authorUsername',
              'authorPhotoURL',
              'content',
              'createdAt',
              'likes'
            ])
          && request.resource.data.keys().hasOnly([
            'authorId',
            'authorUsername',
            'authorPhotoURL',
            'content',
            'createdAt',
            'likes'
          ])
          && isValidCommentData(request.resource.data)
          && request.resource.data.likes.size() == 0;
        allow update: if isAuthenticated()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content'])
          && isValidCommentData(request.resource.data);
        allow update: if isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes'])
          && togglesOnlyOwnUid(
            resource.data.likes,
            request.resource.data.likes
          );
        allow delete: if isAuthenticated()
          && (resource.data.authorId == request.auth.uid || isSuperAdmin());

        match /replies/{replyId} {
          allow read: if true;
          allow create: if isAuthenticated()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.keys()
              .hasAll([
                'authorId',
                'authorUsername',
                'authorPhotoURL',
                'content',
                'createdAt'
              ])
            && request.resource.data.keys().hasOnly([
              'authorId',
              'authorUsername',
              'authorPhotoURL',
              'content',
              'createdAt'
            ])
            && isValidReplyData(request.resource.data);
          allow update: if isAuthenticated()
            && resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['content'])
            && isValidReplyData(request.resource.data);
          allow delete: if isAuthenticated()
            && (resource.data.authorId == request.auth.uid || isSuperAdmin());
        }
      }
    }

    // ============================================================================
    // PLAYERS COLLECTION (manual player database)
    // ============================================================================

    match /players/{playerId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ============================================================================
    // LA LIGA PLAYERS COLLECTION (synced from API)
    // ============================================================================

    match /laLigaPlayers/{playerId} {
      // Anyone can read player data (needed for league creation, transfers, etc.)
      allow read: if true;
      // Only Cloud Functions can write (sync managed by server)
      allow write: if false;
    }

    match /laLigaSyncRuns/{runId}/players/{playerId} {
      // A completed run becomes visible only after config/laLigaSync points to it.
      allow read: if
        get(/databases/$(database)/documents/config/laLigaSync).data.activeRunId == runId;
      allow write: if false;
    }

    // ============================================================================
    // CONFIG COLLECTION (app configuration)
    // ============================================================================

    match /config/{configId} {
      // Status endpoints can be read by authenticated users
      allow read: if isAuthenticated();
      // Only Cloud Functions can write config
      allow write: if false;
    }

    // ============================================================================
    // DENY ALL OTHER ACCESS
    // ============================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
