rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType is string
        && request.resource.contentType.matches(
          'image/(jpeg|png|webp|gif)'
        );
    }

    function isSuperAdmin() {
      return isAuthenticated()
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.appRole == 'superadmin';
    }

    function isChatParticipant(chatId) {
      return isAuthenticated()
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/chats/$(chatId)
        ).data.participants;
    }

    function isSeasonAdmin(leagueId, seasonId) {
      let season = firestore.get(
        /databases/(default)/documents/leagues/$(leagueId)/seasons/$(seasonId)
      ).data;
      return isAuthenticated()
        && request.auth.uid in season.members
        && season.members[request.auth.uid].role == 'admin';
    }

    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    match /profile-pictures/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId);
    }

    match /chats/{chatId}/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow create, update: if isChatParticipant(chatId) && isValidImage();
      allow delete: if isChatParticipant(chatId);
    }

    match /season-pictures/{leagueId}/{seasonId} {
      allow read: if isAuthenticated();
      allow create, update: if isSeasonAdmin(leagueId, seasonId)
        && isValidImage();
      allow delete: if isSeasonAdmin(leagueId, seasonId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
